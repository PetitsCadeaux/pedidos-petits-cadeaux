# Copiá este archivo como .env (nunca se sube al repo) y completá los valores.
# Sin URL y clave, el panel arranca en MODO DEMO con datos de ejemplo.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo la clave "anon" / publishable. Jamás la service_role.
VITE_SUPABASE_ANON_KEY=

# Opcionales
VITE_EMPRESA_NOMBRE=Pazzi
VITE_ZONA_HORARIA=America/Argentina/Buenos_Aires
VITE_TURNO_INICIO=6
VITE_TURNO_FIN=14
# Poné true para forzar el modo demo aunque haya claves (por ejemplo para una presentación)
VITE_MODO_DEMO=false
VITE_BOT_NOMBRE=Bun
